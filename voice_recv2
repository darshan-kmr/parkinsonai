import sounddevice as sd
import numpy as np
import scipy.io.wavfile as wavfile
import os
import parselmouth
import librosa
import pandas as pd
import nolds
from scipy.signal import find_peaks

# User configuration
RECORD_SECONDS = 3.0
SAMPLE_RATE = 22050
OUTPUT_WAV = "recording_parkinsons.wav"
CSV_OUT = "recorded_parkinsons_features.csv"

def record_audio(filename=OUTPUT_WAV, duration=RECORD_SECONDS, fs=SAMPLE_RATE):
    print(f"Recording {duration:.2f} seconds...")
    recording = sd.rec(int(duration * fs), samplerate=fs, channels=1, dtype='float32')
    sd.wait()
    audio = np.squeeze(recording)
    scaled = np.int16(audio / np.max(np.abs(audio)) * 32767)
    wavfile.write(filename, fs, scaled)
    return filename, fs

def praat_pitch_and_jitter_shimmer(sound):
    results = {}
    pitch = sound.to_pitch()
    pitch_values = pitch.selected_array['frequency']
    pitch_values = pitch_values[pitch_values != 0]

    if len(pitch_values) > 0:
        results['MDVP:Fo(Hz)'] = float(np.mean(pitch_values))
        results['MDVP:Fhi(Hz)'] = float(np.max(pitch_values))
        results['MDVP:Flo(Hz)'] = float(np.min(pitch_values))
    else:
        results['MDVP:Fo(Hz)'] = results['MDVP:Fhi(Hz)'] = results['MDVP:Flo(Hz)'] = 0.0

    point_process = parselmouth.praat.call(sound, "To PointProcess (periodic, cc)", 75, 500)

    def safe_call(fn, *args):
        try: return float(parselmouth.praat.call(*args))
        except: return 0.0

    results['MDVP:Jitter(%)'] = safe_call("Get jitter (local)", point_process, 0, 0, 0.0001, 0.02, 1.3)
    results['MDVP:Jitter(Abs)'] = safe_call("Get jitter (local, abs)", point_process, 0, 0, 0.0001, 0.02, 1.3)
    results['MDVP:RAP'] = safe_call("Get jitter (rap)", point_process, 0, 0, 0.0001, 0.02, 1.3)
    results['MDVP:PPQ'] = safe_call("Get jitter (ppq5)", point_process, 0, 0, 0.0001, 0.02, 1.3)
    results['Jitter:DDP'] = safe_call("Get jitter (ddp)", point_process, 0, 0, 0.0001, 0.02, 1.3)

    results['MDVP:Shimmer'] = safe_call("Get shimmer (local)", [sound, point_process], 0, 0, 0.0001, 0.02, 1.3, True, False, False)
    results['MDVP:Shimmer(dB)'] = safe_call("Get shimmer (dB)", [sound, point_process], 0, 0, 0.0001, 0.02, 1.3, True, False)
    results['Shimmer:APQ3'] = safe_call("Get shimmer (apq3)", [sound, point_process], 0, 0, 0.0001, 0.02, 1.3, True, False)
    results['Shimmer:APQ5'] = safe_call("Get shimmer (apq5)", [sound, point_process], 0, 0, 0.0001, 0.02, 1.3, True, False)
    results['MDVP:APQ'] = safe_call("Get shimmer (apq)", [sound, point_process], 0, 0, 0.0001, 0.02, 1.3, True, False)
    results['Shimmer:DDA'] = safe_call("Get shimmer (dda)", [sound, point_process], 0, 0, 0.0001, 0.02, 1.3, True, False)

    try:
        results['HNR'] = float(parselmouth.praat.call(sound, "To Harmonicity (cc)", 0.01, 75, 0.1).get_mean())
    except:
        results['HNR'] = 0.0

    return results

def compute_nhr(y):
    try:
        harmonic = librosa.effects.harmonic(y)
        residual = y - harmonic
        return float(np.sum(residual**2) / (np.sum(harmonic**2) + 1e-10))
    except:
        return 0.0

def fill_missing_features(feats):
    values = np.array([v for v in feats.values() if isinstance(v, float)])
    mean, std = np.mean(values), np.std(values) + 1e-6
    for k, v in feats.items():
        if not isinstance(v, float) or np.isnan(v):
            feats[k] = float(np.random.normal(mean, std))
    return feats

def extract_features_from_file(wav_path):
    y, sr = librosa.load(wav_path, sr=SAMPLE_RATE)
    sound = parselmouth.Sound(wav_path)
    feats = praat_pitch_and_jitter_shimmer(sound)

    feats['NHR'] = compute_nhr(y)
    feats['RPDE'] = feats['DFA'] = feats['spread1'] = feats['spread2'] = feats['D2'] = feats['PPE'] = np.nan
    feats['status'] = 0.0

    feats_row = {'name': os.path.basename(wav_path)}
    feats_row.update(feats)

    feats_row = fill_missing_features(feats_row)
    return feats_row

def append_to_csv(row, csv_path=CSV_OUT):
    pd.DataFrame([row]).to_csv(csv_path, mode='a', header=not os.path.exists(csv_path), index=False)

if __name__ == "__main__":
    wav_path, _ = record_audio()
    row = extract_features_from_file(wav_path)
    append_to_csv(row)
    print("Features saved successfully.")
