# User configuration
RECORD_SECONDS = 3.0       # duration to record (try 3-5s of sustained vowel 'a')
SAMPLE_RATE = 22050       # sampling rate (Hz)
OUTPUT_WAV = "recording_parkinsons.wav"
CSV_OUT = "recorded_parkinsons_features.csv"

def record_audio(filename=OUTPUT_WAV, duration=RECORD_SECONDS, fs=SAMPLE_RATE):
    print(f"Recording {duration:.2f} seconds from default microphone (fs={fs}) — say a few words like hi hello how are you")
    recording = sd.rec(int(duration * fs), samplerate=fs, channels=1, dtype='float32')
    sd.wait()
    audio = np.squeeze(recording)
    # normalize to int16 and save
    scaled = np.int16(audio / np.max(np.abs(audio)) * 32767)
    wavfile.write(filename, fs, scaled)
    print(f"Saved recording to: {filename}")
    return filename, fs

def praat_pitch_and_jitter_shimmer(sound):
    """
    Uses parselmouth (Praat) to compute Fo, jitter, shimmer variants, HNR, NHR.
    Returns a dict with keys matching the UCI dataset names where possible.
    """
    results = {}
    # Pitch
    pitch = sound.to_pitch()
    # Median fundamental frequency (Fo)
    pitch_values = pitch.selected_array['frequency']
    pitch_values = pitch_values[pitch_values != 0]
    if len(pitch_values) > 0:
        f0_mean = float(np.mean(pitch_values))
        f0_max = float(np.max(pitch_values))
        f0_min = float(np.min(pitch_values))
    else:
        f0_mean = f0_max = f0_min = 0.0

    results['MDVP:Fo(Hz)'] = f0_mean
    results['MDVP:Fhi(Hz)'] = f0_max
    results['MDVP:Flo(Hz)'] = f0_min

    # Jitter (local), Jitter(Abs), RAP, PPQ, DDP
    point_process = parselmouth.praat.call(sound, "To PointProcess (periodic, cc)", 75, 500)
    try:
        jitter_local = parselmouth.praat.call(point_process, "Get jitter (local)", 0, 0, 0.0001, 0.02, 1.3)
    except Exception:
        jitter_local = 0.0
    try:
        jitter_abs = parselmouth.praat.call(point_process, "Get jitter (local, abs)", 0, 0, 0.0001, 0.02, 1.3)
    except Exception:
        jitter_abs = 0.0
    try:
        jitter_rap = parselmouth.praat.call(point_process, "Get jitter (rap)", 0, 0, 0.0001, 0.02, 1.3)
    except Exception:
        jitter_rap = 0.0
    try:
        jitter_ppq = parselmouth.praat.call(point_process, "Get jitter (ppq5)", 0, 0, 0.0001, 0.02, 1.3)
    except Exception:
        jitter_ppq = 0.0
    try:
        jitter_ddp = parselmouth.praat.call(point_process, "Get jitter (ddp)", 0, 0, 0.0001, 0.02, 1.3)
    except Exception:
        jitter_ddp = 0.0

    results['MDVP:Jitter(%)'] = float(jitter_local) if jitter_local not in [None, ''] else 0.0
    results['MDVP:Jitter(Abs)'] = float(jitter_abs) if jitter_abs not in [None, ''] else 0.0
    results['MDVP:RAP'] = float(jitter_rap) if jitter_rap not in [None, ''] else 0.0
    results['MDVP:PPQ'] = float(jitter_ppq) if jitter_ppq not in [None, ''] else 0.0
    results['Jitter:DDP'] = float(jitter_ddp) if jitter_ddp not in [None, ''] else 0.0

    # Shimmer measures
    try:
        shimmer_local = parselmouth.praat.call([sound, point_process], "Get shimmer (local)", 0, 0, 0.0001, 0.02, 1.3, True, False, False)
    except Exception:
        shimmer_local = 0.0
    try:
        shimmer_db = parselmouth.praat.call([sound, point_process], "Get shimmer (dB)", 0, 0, 0.0001, 0.02, 1.3, True, False)
    except Exception:
        shimmer_db = 0.0
    try:
        apq3 = parselmouth.praat.call([sound, point_process], "Get shimmer (apq3)", 0, 0, 0.0001, 0.02, 1.3, True, False)
    except Exception:
        apq3 = 0.0
    try:
        apq5 = parselmouth.praat.call([sound, point_process], "Get shimmer (apq5)", 0, 0, 0.0001, 0.02, 1.3, True, False)
    except Exception:
        apq5 = 0.0
    try:
        apq = parselmouth.praat.call([sound, point_process], "Get shimmer (apq)", 0, 0, 0.0001, 0.02, 1.3, True, False)
    except Exception:
        apq = 0.0
    try:
        dda = parselmouth.praat.call([sound, point_process], "Get shimmer (dda)", 0, 0, 0.0001, 0.02, 1.3, True, False)
    except Exception:
        dda = 0.0

    results['MDVP:Shimmer'] = float(shimmer_local) if shimmer_local not in [None, ''] else 0.0
    results['MDVP:Shimmer(dB)'] = float(shimmer_db) if shimmer_db not in [None, ''] else 0.0
    results['Shimmer:APQ3'] = float(apq3) if apq3 not in [None, ''] else 0.0
    results['Shimmer:APQ5'] = float(apq5) if apq5 not in [None, ''] else 0.0
    results['MDVP:APQ'] = float(apq) if apq not in [None, ''] else 0.0
    results['Shimmer:DDA'] = float(dda) if dda not in [None, ''] else 0.0

    # Harmonics-to-noise ratio (HNR) via Praat
    try:
        hnr = parselmouth.praat.call(sound, "To Harmonicity (cc)", 0.01, 75, 0.1).get_mean()
    except Exception:
        hnr = 0.0
    results['HNR'] = float(hnr) if hnr not in [None, ''] else 0.0



    return results


def compute_nhr_hnr_librosa(y, sr):
    y = y.astype(float)
    try:
        harmonic = librosa.effects.harmonic(y)
        residual = y - harmonic
        eps = 1e-10
        harmonic_energy = np.sum(harmonic**2) + eps
        residual_energy = np.sum(residual**2)
        nhr = residual_energy / harmonic_energy
    except Exception:
        nhr = np.nan
    return nhr

