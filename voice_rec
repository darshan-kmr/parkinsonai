def extract_features_from_file(wav_path): 
    # load raw
    y, sr = librosa.load(wav_path, sr=SAMPLE_RATE)
    # parselmouth sound
    sound = parselmouth.Sound(wav_path)
    feats = praat_pitch_and_jitter_shimmer(sound)

    # compute NHR approximation via librosa
    nhr_value = compute_nhr_hnr_librosa(y, sr)
    feats['NHR'] = float(nhr_value) if not np.isnan(nhr_value) else np.nan
    feats['RPDE'] = compute_rpde_placeholder(y, sr)
    feats['DFA'] = compute_dfa(y)
    spread1, spread2 = compute_spread1_spread2_placeholder(y)
    feats['spread1'] = spread1
    feats['spread2'] = spread2
    feats['D2'] = compute_d2_placeholder(y)
    feats['PPE'] = compute_ppe_placeholder(y, sr)

    # Status: unknown (we're not diagnosing) — set as NaN or 0
    feats['status'] = np.nan

    # Return a well-ordered list (name then features)
    ordered_keys = [
        'name', 'MDVP:Fo(Hz)', 'MDVP:Fhi(Hz)', 'MDVP:Flo(Hz)',
        'MDVP:Jitter(%)', 'MDVP:Jitter(Abs)', 'MDVP:RAP', 'MDVP:PPQ', 'Jitter:DDP',
        'MDVP:Shimmer', 'MDVP:Shimmer(dB)', 'Shimmer:APQ3', 'Shimmer:APQ5', 'MDVP:APQ', 'Shimmer:DDA',
        'NHR', 'HNR', 'status', 'RPDE', 'DFA', 'spread1', 'spread2', 'D2', 'PPE'
    ]

    # name = filename
    feats_row = {'name': os.path.basename(wav_path)}
    for k in ordered_keys:
        if k == 'name':
            continue
        feats_row[k] = feats.get(k, np.nan)
    return feats_row

def append_to_csv(row_dict, csv_path=CSV_OUT):
    df_row = pd.DataFrame([row_dict])
    if not os.path.exists(csv_path):
        df_row.to_csv(csv_path, index=False)
        print(f"Created CSV and appended row: {csv_path}")
    else:
        df_row.to_csv(csv_path, mode='a', header=False, index=False)
        print(f"Appended row to existing CSV: {csv_path}")

if __name__ == "__main__":
    wav_path, sr = record_audio()
    feats_row = extract_features_from_file(wav_path)
    # Print nicely
    print("\n--- Extracted Features ---")
    for k, v in feats_row.items():
        print(f"{k}: {v}")
    append_to_csv(feats_row)
    print("\nDone. If you need RPDE/D2/spread/PPE implemented fully, tell me and I will add robust implementations.")
