import pandas as pd
import joblib

model = joblib.load("/Users/darshan/darhsna website/video edit pytthon/parkinsons-project/mlruns/best_parkinsons_model.pkl")
scaler = joblib.load("/Users/darshan/darhsna website/video edit pytthon/parkinsons-project/scaler.pkl")
feature_columns = joblib.load("/Users/darshan/darhsna website/video edit pytthon/parkinsons-project/feature_columns.pkl")

df = pd.read_csv("/Users/darshan/darhsna website/video edit pytthon/parkinsons-project/recorded_parkinsons_features.csv")
sample = df.tail(1)

X = sample.drop(columns=["name", "status"])
X = X[feature_columns]
X = scaler.transform(X)

prediction = model.predict(X)[0]
confidence = max(model.predict_proba(X)[0]) * 100

print("\n==============================")
print("Prediction:", "Parkinson's" if prediction else "Healthy")
print(f"Confidence: {confidence:.2f}%")
print("==============================\n")
